---
/**
 * Soft floating blobs in the lower viewport band.
 * Motion is slow sin/cos drift + light separation — enough for 6 large circles.
 * Blur comes from the container CSS filter (see --bubble-container-blur).
 */
const count = 6;
const minRadius = 250;
const maxRadius = 400;
const bottomBandStart = 0.8;
const targetFps = 6;
const startDelayMs = 1500;
---

<div class="bubble-container" aria-hidden="true">
  <canvas id="bubble-canvas"></canvas>
</div>

<style>
  .bubble-container {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    filter: blur(var(--bubble-container-blur, 50px));
    opacity: 0;
    animation: bubble-fade-in 1s ease forwards;
    pointer-events: none;
  }

  @keyframes bubble-fade-in {
    to {
      opacity: 1;
    }
  }

  #bubble-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script define:vars={{ count, minRadius, maxRadius, bottomBandStart, targetFps, startDelayMs }}>
  const canvas = document.getElementById("bubble-canvas");
  if (!(canvas instanceof HTMLCanvasElement)) throw new Error("Canvas not found");

  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("2d context unavailable");

  const dpr = Math.min(2, window.devicePixelRatio || 1);
  const frameInterval = 1000 / Math.max(1, targetFps);
  let width = 0;
  let height = 0;
  let animRef = 0;
  let lastTime = 0;
  let accumulated = 0;
  let resizeTimer = null;

  function rand(min, max) {
    return Math.random() * (max - min) + min;
  }

  function readPalette() {
    const styles = getComputedStyle(document.documentElement);
    const fromCss = Array.from({ length: count }, (_, i) =>
      styles.getPropertyValue(`--bubble-color-${i + 1}`).trim(),
    ).filter(Boolean);
    return fromCss.length > 0
      ? fromCss
      : ["#FCC841", "#DFEFFC", "#DEDE92", "#DE4331", "#FE9750", "#FCC841"];
  }

  function readAlpha() {
    const raw = getComputedStyle(document.documentElement)
      .getPropertyValue("--bubble-alpha")
      .trim();
    const n = Number(raw);
    return Number.isFinite(n) ? n : 0.8;
  }

  function resize() {
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  /** @type {{ x: number, y: number, r: number, colorIndex: number, phase: number, speed: number, vx: number, vy: number }[]} */
  const bubbles = [];

  function seedBubbles() {
    bubbles.length = 0;
    for (let i = 0; i < count; i++) {
      bubbles.push({
        x: ((i + 0.5) / count) * width + rand(-40, 40),
        y: rand(height * bottomBandStart, height * 1.15),
        r: rand(minRadius, maxRadius),
        colorIndex: i,
        phase: rand(0, Math.PI * 2),
        speed: rand(0.08, 0.16),
        vx: 0,
        vy: 0,
      });
    }
  }

  function update(t) {
    const bandMin = height * bottomBandStart;
    const bandMax = height * 1.35;
    const time = t * 0.0004;

    for (let i = 0; i < bubbles.length; i++) {
      const b = bubbles[i];

      // Smooth wander without embedding a Simplex implementation.
      b.vx = Math.cos(time * b.speed + b.phase) * 0.35;
      b.vy = Math.sin(time * b.speed * 0.85 + b.phase * 1.3) * 0.2;

      // Light pairwise separation (O(n²) is fine for n=6).
      for (let j = 0; j < bubbles.length; j++) {
        if (j === i) continue;
        const o = bubbles[j];
        const dx = b.x - o.x;
        const dy = b.y - o.y;
        const minD = (b.r + o.r) * 0.35;
        const d2 = dx * dx + dy * dy;
        if (d2 > 0.001 && d2 < minD * minD) {
          const d = Math.sqrt(d2);
          const push = ((minD - d) / minD) * 0.6;
          b.vx += (dx / d) * push;
          b.vy += (dy / d) * push;
        }
      }

      b.x += b.vx;
      b.y += b.vy;

      if (b.x < -b.r) b.x = width + b.r;
      if (b.x > width + b.r) b.x = -b.r;
      b.y = Math.min(Math.max(b.y, bandMin - b.r * 0.2), bandMax);
    }
  }

  function draw() {
    const palette = readPalette();
    const alpha = readAlpha();
    ctx.clearRect(0, 0, width, height);
    ctx.globalAlpha = alpha;
    for (const b of bubbles) {
      ctx.beginPath();
      ctx.fillStyle = palette[b.colorIndex % palette.length];
      ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function frame(t) {
    if (document.hidden) {
      animRef = requestAnimationFrame(frame);
      return;
    }

    const delta = lastTime ? t - lastTime : 0;
    lastTime = t;
    accumulated += delta;
    if (accumulated < frameInterval) {
      animRef = requestAnimationFrame(frame);
      return;
    }
    accumulated = 0;

    update(t);
    draw();
    animRef = requestAnimationFrame(frame);
  }

  resize();
  seedBubbles();
  draw();

  const ro = new ResizeObserver(() => {
    if (resizeTimer !== null) window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      resize();
      draw();
      resizeTimer = null;
    }, 400);
  });
  ro.observe(canvas);

  const onThemeChange = () => draw();
  document.addEventListener("wonderland:theme-change", onThemeChange);

  const start = () => {
    animRef = requestAnimationFrame(frame);
  };
  if (window.innerWidth < 640) {
    setTimeout(start, startDelayMs);
  } else {
    start();
  }

  document.addEventListener("astro:before-swap", () => {
    cancelAnimationFrame(animRef);
    document.removeEventListener("wonderland:theme-change", onThemeChange);
    ro.disconnect();
    if (resizeTimer !== null) window.clearTimeout(resizeTimer);
  });
</script>
